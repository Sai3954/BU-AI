# ---- App ----
APP_NAME=BU AI
APP_TAGLINE=Intelligent Student Success Platform
UNIVERSITY_NAME=Belhaven University
# Required for /admin. 20+ characters, 3 character types, no common words; /admin stays off until it passes.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# Leave empty to use SQLite (zero setup). docker-compose sets a Postgres URL automatically.
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/assistant

# ---- AI provider: none | openai | azure | anthropic ----
# "none" still works: it answers with the best-matching official text, with citations.
LLM_PROVIDER=none

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Azure OpenAI (recommended for a university deployment)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Vector search embeddings: auto | openai | azure | none
# auto = use OpenAI/Azure embeddings when a key is set, otherwise keyword search only.
EMBEDDINGS_PROVIDER=auto

# ---- Crawler ----
CRAWL_MAX_PAGES=400
CRAWL_DELAY_SECONDS=1.0

# ---- Protection ----
CHAT_RATE_PER_MINUTE=12        # questions per minute per visitor
DAILY_AI_LIMIT=2000            # AI calls per day; after that, official-text answers (cost cap)
MAX_CONCURRENT_PER_IP=2        # simultaneous answers per visitor
VERIFY_WITH_AI=false           # true = a second AI pass reviews every answer against its sources (about 2x AI cost)
TRUST_PROXY=false              # true when running behind a reverse proxy / Azure ingress

# ---- Automatic refresh ----
CRAWL_EVERY_HOURS=0            # e.g. 24 = re-crawl the website daily inside the API (0 = off)
INDEX_WATCH_SECONDS=60         # pick up content changed by a separate crawler run
